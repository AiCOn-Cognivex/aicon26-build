# ---- backend (never commit a real .env) ----
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
MODEL_KIND=auto            # rules | crf | lilt | auto
OCR_THREADS=               # optional; default = container CPU quota
MODEL_REPO=                # HF Hub model repo with trained artifacts, e.g. AiCOn-Cognivex/cord-receipt-models
HF_TOKEN=                  # only needed to UPLOAD artifacts (training machine), not to download public ones
# ---- frontend (Vercel project env) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
