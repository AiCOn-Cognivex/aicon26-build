# ---- backend (never commit a real .env) ----
ALLOWED_ORIGINS=http://localhost:3000,https://YOUR-APP.vercel.app
DATABASE_URL=              # Postgres (Neon) URL; unset = local SQLite file with re-seeded demo data
JWT_SECRET=                # long random string; unset = random per process (sessions end on restart)
GEMINI_API_KEY=            # optional: switches on Ask Repay + the fallback receipt reader (never auto-approve)
GEMINI_MODEL=gemini-3.8-flash
SEED_DEMO=1                # seed the fictional demo company when the database is empty
MODEL_KIND=auto            # rules | crf | lilt | auto
OCR_THREADS=               # optional; default = container CPU quota
MODEL_REPO=                # HF Hub model repo with trained artifacts, e.g. AiCOn-Cognivex/cord-receipt-models
HF_TOKEN=                  # only needed to UPLOAD artifacts (training machine), not to download public ones
# ---- frontend (Vercel project env) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
